{
  "name": "aiwatcher-mcp",
  "version": "0.1.0",
  "description": "AI news ingestion, distillation, and alert system. Polls RSS/Atom and optional Gmail, arXiv, and Readly; scores with Claude or local LLMs; digests and fleet alerts via robofang and speechops. Starlette REST + MCP HTTP on :10946 (/mcp); stdio MCP via python -m aiwatcher_mcp.server.",
  "author": "Sandra Schipal",
  "license": "MIT",
  "homepage": "https://github.com/sandraschi/aiwatcher-mcp",
  "tags": ["ai", "news", "rss", "alerts", "digest", "distillation", "fastmcp", "mcp", "fleet"],
  "category": "productivity",
  "tools": [
    "poll_feeds",
    "distill_pending",
    "check_alerts",
    "generate_digest",
    "send_digest_now",
    "get_bundles_list",
    "create_bundle_from_topic",
    "list_fleet_bundles",
    "update_fleet_bundle",
    "link_feed_to_bundle",
    "get_top_items",
    "get_feeds_list",
    "search_items",
    "get_digest_history",
    "expire_old_items",
    "get_feed_health",
    "add_feed",
    "get_bundle_health",
    "find_feeds_for_topic",
    "import_opml",
    "scrubber_reload",
    "show_dashboard_card"
  ],
  "prompts": [
    "breaking_news_brief",
    "portfolio_impact_analysis"
  ],
  "resources": [
    "aiwatcher://feeds/list",
    "aiwatcher://stats"
  ],
  "transport": {
    "stdio": true,
    "http": true,
    "http_path": "/mcp"
  },
  "ports": {
    "backend": 10946,
    "frontend": 10947
  },
  "fleet": {
    "server_name": "aiwatcher-mcp",
    "robofang_integration": true,
    "email_integration": true,
    "calibre_integration": true,
    "speechops_integration": true
  }
}
