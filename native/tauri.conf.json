{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AIWatcher MCP",
  "version": "0.1.0",
  "identifier": "com.sandraschi.aiwatcher-mcp",
  "build": {
    "frontendDist": "../webapp/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AIWatcher MCP",
        "width": 1280,
        "height": 860,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/aiwatcher-mcp-backend.exe"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {}
}
