# ── aiwatcher-mcp environment configuration ───────────────────────────────────
# Copy to .env and fill in secrets. Never commit .env.
#
# Recommended configs:
#   Local-only (default):
#     LLM_PROVIDER=lmstudio
#     DISTILLATION_MODEL=gemma-3-27b-it
#     DISTILLATION_FLASH_ENABLED=true
#     DISTILLATION_FLASH_PROVIDER=lmstudio
#     DISTILLATION_FLASH_MODEL=gemma-3-1b-it
#
#   Local + DeepSeek cloud (cheapest cloud tier):
#     LLM_PROVIDER=deepseek
#     CLOUD_PROVIDERS_ALLOWED=deepseek
#     DEEPSEEK_API_KEY=sk-...
#     DISTILLATION_MODEL=deepseek-v4-pro
#     DISTILLATION_FLASH_ENABLED=true
#     DISTILLATION_FLASH_PROVIDER=lmstudio
#     DISTILLATION_FLASH_MODEL=gemma-3-1b-it

# --- Server ---
BACKEND_PORT=10946
FRONTEND_PORT=10947
LOG_LEVEL=INFO
# Fleet Intel Reports Hub (Fritz + AIWatcher HTML reports for iPad / Tailscale)
INTEL_REPORTS_HUB_URL=http://127.0.0.1:11027
# Optional REST auth (empty = disabled). When set, send X-AIWatcher-Key or Authorization: Bearer on /api/*.
# /health and /mcp stay public.
AIWATCHER_API_KEY=

# --- Database ---
DB_PATH=data/aiwatcher.db

# --- Feed polling ---
FEED_POLL_INTERVAL_MINUTES=30
MAX_ITEMS_PER_FEED=50
# Reuse last generated digest body for this many minutes (0 = always regenerate)
DIGEST_CACHE_TTL_MINUTES=60
# Optional interests.json sync (scheduler job + startup)
INTERESTS_JSON_PATH=interests.json
# Feed quality decay (30d window)
FEED_DECAY_DAYS=30
FEED_DECAY_MIN_ITEMS=5
FEED_DECAY_URGENCY_THRESHOLD=2.0
# Portfolio watch — comma-separated terms; +URGENCY boost on match
PORTFOLIO_WATCH_TERMS=fastmcp,anthropic,openai,cursor,mcp fleet
PORTFOLIO_WATCH_URGENCY_BOOST=1.0
# Digest audience tone hints for Sandra vs Steve
DIGEST_TONE_SANDRA=Technical depth: MCP fleet, tooling, Vienna ops.
DIGEST_TONE_STEVE=Accessible summary for a retired bank IT reader.

# --- LLM Provider (lmstudio | ollama | deepseek | anthropic) ---
# Local-first: lmstudio and ollama are always allowed (no API key needed).
# Cloud providers (deepseek, anthropic) require CLOUD_PROVIDERS_ALLOWED + API key.
LLM_PROVIDER=lmstudio
LLM_BASE_URL=http://localhost:1234/v1

# --- Cloud provider allow-matrix ---
# Comma-separated list of cloud providers allowed for distillation.
# Empty = local-only (lmstudio/ollama). Set to "deepseek" or "deepseek,anthropic"
# to enable cloud API calls. This gates ALL cloud usage.
CLOUD_PROVIDERS_ALLOWED=

# --- DeepSeek (V4 Flash $0.14/M in, $0.28/M out — cheapest cloud option) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Anthropic (Claude — expensive, quality-critical only) ---
ANTHROPIC_API_KEY=

# --- Distillation ---
# Pro-tier model: used for digest generation and re-scoring borderline items.
# With LLM_PROVIDER=deepseek: use deepseek-v4-pro (reasoning) or deepseek-v4-flash.
# With LLM_PROVIDER=lmstudio: use the model loaded in LM Studio (e.g. gemma-3-27b-it).
DISTILLATION_MODEL=gemma-3-27b-it
DISTILLATION_INTERVAL_HOURS=6

# --- Tiered distillation (flash-first for cost efficiency) ---
# When enabled: all items scored by cheap flash model first.
# Only borderline items (relevance 4-7) get re-scored by the pro model.
# Flash tier — use cheapest model available (e.g. gemma-3-1b-it in LM Studio)
DISTILLATION_FLASH_ENABLED=false
DISTILLATION_FLASH_PROVIDER=lmstudio
DISTILLATION_FLASH_MODEL=gemma-3-1b-it
DISTILLATION_FLASH_BASE_URL=
# Borderline range: items with relevance in [min, max] get re-scored by pro model
DISTILLATION_BORDERLINE_MIN=4.0
DISTILLATION_BORDERLINE_MAX=7.0

# --- Alert thresholds ---
# Items scored >= this wake Sandra up via TTS at ALERT_HOUR_UTC:ALERT_MINUTE_UTC
ALERT_THRESHOLD=8.5
ALERT_HOUR_UTC=4      # 4 UTC = 5am Vienna (CET) / 6am Vienna (CEST)
ALERT_MINUTE_UTC=55

# --- Speechops integration ---
# REST endpoint of the speechops backend (separate from MCP transport)
SPEECHOPS_HTTP_URL=http://localhost:10895

# --- Robofang integration ---
ROBOFANG_BACKEND_URL=http://localhost:10871
ROBOFANG_ENABLED=true

# --- Email delivery ---
EMAIL_ENABLED=false
EMAIL_RECIPIENTS=sandra@example.com,steve@example.com
EMAIL_SUBJECT_PREFIX=[AIWatcher]
# email-mcp REST base URL (preferred if running)
EMAIL_MCP_URL=http://localhost:10812
# SMTP fallback (used when EMAIL_MCP_URL is empty or unreachable)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Calibre-mcp integration ---
CALIBRE_ENABLED=false
CALIBRE_MCP_URL=http://localhost:10720
CALIBRE_LIBRARY=AI News

# --- Gmail / Alpha Signal email ingestion ---
GMAIL_ENABLED=false
GMAIL_MCP_URL=http://localhost:10812
ALPHASIGNAL_SENDER=newsletter@alphasignal.ai

# --- ArXiv ingestion (arxiv-mcp on port 10770) ---
ARXIV_ENABLED=true
ARXIV_MCP_URL=http://localhost:10770
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.RO,cs.SD

# --- VLA robotics bridge (vla-mcp on port 11024) ---
VLA_MCP_ENABLED=true
VLA_MCP_URL=http://localhost:11024

# --- Readly magazine ingestion (readly-mcp on port 10863) ---
READLY_ENABLED=false
READLY_MCP_URL=http://localhost:10863
# Comma-separated watchlist — enables 6h scheduler job + full-text ingest via readly 0.2.1 API
READLY_WATCHLIST=New Scientist,MIT Technology Review,c't,Wired,Die Presse,NZZ
READLY_POLL_MAX_ARTICLES=10
READLY_POLL_INTERVAL_HOURS=6

# --- Retention ---
# Items older than this (days) are deleted by the nightly 03:00 UTC job.
# Items with urgency_score >= 8.5 are kept permanently regardless of age.
ITEM_RETENTION_DAYS=90

# --- Prefab UI ---
AIWATCHER_PREFAB_APPS=true

# --- MCP Bridge ---
# MCP_BRIDGE_URLS=http://localhost:10782/mcp,http://localhost:10756/mcp
